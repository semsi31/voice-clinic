# Supabase — Voice Klinik Yönetim Paneli
# Gerçek değerleri buraya yazmayın. Bu dosyayı kopyalayıp .env.local oluşturun.
#
# Vercel Production için zorunlu:
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  (veya NEXT_PUBLIC_SUPABASE_ANON_KEY)
#   NEXT_PUBLIC_SITE_URL
# SUPABASE_SERVICE_ROLE_KEY bu projede kullanılmaz.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Eski ad (opsiyonel yedek):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (SEO: metadataBase, canonical, sitemap, Open Graph)
# Production'da mutlaka gerçek domain yazın. localhost kullanmayın.
NEXT_PUBLIC_SITE_URL=https://voice-clinic-sage.vercel.app

# Cloudflare R2 — panel belgeleri ve site görselleri (CDN)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
# Public CDN origin (no trailing slash). Required for site images.
# Example: https://pub-xxxxxxxx.r2.dev  or  https://cdn.yourdomain.com
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Mutation timing logs ([mutation-perf]) — set to 1 in Runtime Logs debugging
# MUTATION_PERF_LOG=1
